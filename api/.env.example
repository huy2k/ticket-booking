# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_booking?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key
JWT_EXPIRES_IN=7d

# Queue config
QUEUE_MAX_ACTIVE=100         # Max people in checkout area
HEARTBEAT_TTL_SECONDS=30     # Remove from queue if no heartbeat
SEAT_LOCK_MINUTES=10         # Pending seat lock duration

# CORS
CORS_ORIGIN=http://localhost:3001
